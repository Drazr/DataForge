# Server-side only. Copy to .env in this product worktree.
RIME_API_KEY=
RIME_SPEAKER=astra
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: record a region only after verifying it for the actual deployment.
LIVEKIT_REGION_LABEL=
DATAFORGE_INTERPRETER=guided
# Enables explicit failure controls and unattended acceptance scenarios locally.
DATAFORGE_TEST_MODE=0
# Optional Windows Microsoft C++ runtime directory, if not installed globally.
DATAFORGE_DLL_DIRECTORY=
